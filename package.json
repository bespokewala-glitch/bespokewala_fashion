{
  "name": "fashion-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('.next', { recursive: true, force: true });\"",
    "dev": "next dev",
    "dev:turbo": "npm run clean && next dev --turbo",
    "build": "node -e \"const fs = require('fs'); fs.rmSync('.next/dev', { recursive: true, force: true });\" && node --max-old-space-size=8192 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:api": "jest --selectProjects api",
    "test:components": "jest --selectProjects components",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google-cloud/storage": "^7.21.0",
    "@google-cloud/tasks": "^6.3.0",
    "@google-cloud/video-transcoder": "^4.4.3",
    "@google/generative-ai": "^0.24.1",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.25.0",
    "mongoose": "^9.7.4",
    "next": "16.2.10",
    "razorpay": "^2.9.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.1.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-environment-node": "^30.5.1",
    "jest-mock": "^30.5.1",
    "mongodb": "^7.5.0",
    "mongodb-memory-server": "^10.4.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@img/sharp-linux-musl-x64": "^0.33.5",
    "@img/sharp-linux-x64": "^0.33.5",
    "@img/sharp-win32-x64": "^0.33.5"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "sharp@0.33.5": true,
    "unrs-resolver@1.12.2": true
  }
}
