# ==============================================================================
# Bespokewala E-Commerce — Environment Variables Template
# Copy this file to .env.local for local development.
# ==============================================================================

# Application
NODE_ENV=development
# Can be named SITE_URL (recommended for Vercel) or NEXT_PUBLIC_SITE_URL
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/bespokewala_fashion
MONGODB_DB=bespokewala_fashion

# JWT & Authentication
# In production, generate a secure 32+ character key (e.g., openssl rand -base64 48)
JWT_SECRET=your-jwt-secret-key-here
INTERNAL_API_SECRET=your-internal-api-secret-key
ADMIN_SETUP_SECRET=your-admin-setup-secret-token
ADMIN_INITIAL_EMAIL=admin@bespokewala.com
ADMIN_INITIAL_PASSWORD=your-secure-initial-admin-password

# Razorpay Payment Gateway (Test or Live credentials)
# RAZORPAY_KEY_ID is public-safe (rzp_live_... / rzp_test_...).
# The server passes it directly to CheckoutClient; NEXT_PUBLIC_ prefix is not required.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Google Cloud Storage (Media & Assets)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_BUCKET_NAME=your-gcs-bucket-name
NEW_PUBLIC_BUCKET_NAME=your-public-gcs-bucket-name
GOOGLE_CLOUD_PRIVATE_BUCKET_NAME=your-private-gcs-bucket-name
# Full JSON service account key (single line string or base64)
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
EMAIL_FROM="Bespokewala" <noreply@bespokewala.com>
EMAIL_ADMIN_TO=admin@bespokewala.com

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Analytics & Marketing (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=0000000000000000
META_ACCESS_TOKEN=your-meta-conversions-token

# Distributed Rate Limiting (Optional - falls back to in-memory if empty)
# REDIS_URL=redis://localhost:6379

# Optional: set to true to block checkout when inventoryCount < quantity. Default (unset) = made-to-order, no stock blocking.
# ENFORCE_STOCK_LIMITS=false
